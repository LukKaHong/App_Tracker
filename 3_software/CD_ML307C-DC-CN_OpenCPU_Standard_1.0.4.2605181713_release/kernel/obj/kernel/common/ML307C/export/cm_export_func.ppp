static inline struct netif * netif_find_by_num(int num)
{
    struct netif *netif = 0;

    /*num = 0, denote app of modul*/
    if (num <= 0) { return 0; }

    for(netif = netif_list; netif != 0; netif = netif->next) {
        if (netif->num == (u8_t)num) { return netif; }
    }

    return 0;
}

static inline int netif_check_nw_if(struct netif *inp)
{
    return((inp 
        && (((inp)->flags & 0x0200U) ? 1 : 0) 
        && !(((inp)->flagsEx & 0x400000U ) ? 1 : 0)) ? 1 : 0);
}

static inline int netif_check_nw_default(struct netif *inp)
{
    return((inp && (inp == netif_default)) ? 1 : 0);
}

static inline int netif_check_nw_default_ip6(struct netif *inp)
{   
    return((inp && (inp == netif_default_ip6)) ? 1 : 0);
}
static inline struct netif* netif_get_default_if(void)
{
    return((netif_default == 0) ? 0 : netif_default);
}

static inline struct netif* netif_get_default_if6(void)
{
    return((netif_default_ip6 == 0) ? 0 : netif_default_ip6);
}

static inline struct netif* netif_get_default_ifppp(void)
{
    return((netif_default_ppp == 0) ? 0 : netif_default_ppp);
}

static inline struct netif* netif_get_default_nw(void)
{
    if (netif_default) {
        if ((((netif_default)->flags & 0x01U) ? 1 : 0) && (((netif_default)->flagsEx & 0x01U) ? 1 : 0)) {
            return netif_default;
        } else {
            return 0;
        }
    }

    if (netif_clat) {
        return netif_clat;
    }

    return 0;
}

static inline struct netif* netif_get_default_nw_ip6(void)
{
    return(((netif_default_ip6 == 0)
        || (!(((netif_default_ip6)->flags & 0x01U) ? 1 : 0))
        || (!(((((netif_default_ip6)->flagsEx & 0x02U) ? 1 : 0)) && (((netif_default_ip6)->flagsEx & (0x08U | 0x40U | 0x100U | 0x200U )) ? 1 : 0)))) ? 0 : netif_default_ip6);
}

static inline struct netif* netif_get_default_nw_ppp (void)
{
    return(((netif_default_ppp == 0) 
        || (!(((netif_default_ppp)->flags & 0x01U) ? 1 : 0))) ? 0 : netif_default_ppp);
}

static inline struct netif* netif_get_clat_nw (void)
{
    return(((netif_clat == 0) 
        || (!(((netif_clat)->flags & 0x01U) ? 1 : 0))) ? 0 : netif_clat);
}

static inline u8_t netif_get_default_nw_status(void)
{
    if (netif_default
        && (((netif_default)->flags & 0x01U) ? 1 : 0)) {
        return 1;
    } 

    return 0;
}

static inline u8_t netif_get_default_nw_status_ip6(void)
{
    if (netif_default_ip6
        && (((netif_default_ip6)->flags & 0x01U) ? 1 : 0)) {
        return 1;
    } 

    return 0;
}

static inline void netif_set_default_nw_status(u8_t flag)
{
    if (netif_default) {
        if (flag == 0) {
            netif_set_down(netif_default);
        } else {
            netif_set_up(netif_default);
        }
    }
}

static inline void netif_set_default_nw_status_ip6(u8_t flag)
{
    if (netif_default_ip6) {
        if (flag == 0) {
            netif_set_down(netif_default_ip6);
        } else {
            netif_set_up(netif_default_ip6);
        }
    }
}

static inline void netif_set_lan(struct netif *netif)
{
    if (netif == 0) {
      return;
    }

    ((netif)->flags &= ~0x0200U);
    ((netif)->flags |= 0x0100U);
}

static inline void netif_set_wan(struct netif *netif)
{
    if (netif == 0) {
      return;
    }

    ((netif)->flags &= ~0x0100U);
    ((netif)->flags |= 0x0200U);
}

static inline struct netif* netif_get_usb_if(void)
{

    extern struct netif netif_pc;
    return &netif_pc;



}

static inline struct netif* netif_get_eth_if(void)
{




    return 0;

}

static inline struct netif* netif_get_uap_if(void)
{

    extern struct netif netif_wifi_uap;
    return &netif_wifi_uap;



}

static inline struct netif* netif_get_ppp_if(void)
{

    extern struct netif netif_ppp;
    return &netif_ppp;



}












