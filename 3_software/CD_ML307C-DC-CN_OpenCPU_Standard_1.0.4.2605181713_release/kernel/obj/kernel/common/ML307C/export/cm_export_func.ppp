static inline int sys_sem_valid(sys_sem_t *sem)
{
    if (OS_SUCCESS == OsaSemaphoreCheck(*sem)) {



        return 1;
    } else {
        return 0;
    }
}

static inline err_t sys_sem_new(sys_sem_t *sem, u8_t count)
{
    OSA_STATUS status;

    status = OSASemaphoreCreate(sem, count, 11);
    { if (!(OS_SUCCESS == status)) { utilsAssertFail("OS_SUCCESS == status", "sys_arch.h", 335, 1); } };
    return ERR_OK;
}

static inline void sys_sem_free(sys_sem_t *sem)
{
    if (sys_sem_valid(sem)) {
        OsaSemaphoreDelete(*sem,0);
        *sem = 0;
    } else {
        /*for inline function, must use LWIP_DEBUGF*/
		do { if (((!diagBlocked . all) && (((g_moduleDebugSettings[(0x00 << 8 & 0xFF00) >> 8]. onoff) == 0x80U) ? 1 : 0) && (LOG_DISABLE != log_config . log_cfg) && (log_config . msg_cfg == ACAT_MSG_ENABLE) && (booting_done))) { LWIP_LOG ("lwiperr: sys_sem_free, sys_sem_valid failed, sem=%lx", sem); ; break; } } while(0);
	}
}

static inline void sys_sem_set_invalid(sys_sem_t *sem)
{
    *sem = 0;
}

static inline void sys_sem_signal(sys_sem_t *sem)
{
    if (OS_SUCCESS == OsaSemaphoreCheck(*sem)) {
        OsaSemaphoreRelease(*sem,0);
    } else {
        /*for inline function, must use LWIP_DEBUGF*/
		do { if (((!diagBlocked . all) && (((g_moduleDebugSettings[(0x00 << 8 & 0xFF00) >> 8]. onoff) == 0x80U) ? 1 : 0) && (LOG_DISABLE != log_config . log_cfg) && (log_config . msg_cfg == ACAT_MSG_ENABLE) && (booting_done))) { LWIP_LOG ("lwiperr: sys_sem_signal, OSASemaphoreCheck failed, sem=%lx", sem); ; break; } } while(0);
	}
}

static inline u32_t sys_arch_sem_wait(sys_sem_t *sem, u32_t timeout)
{
    OSA_STATUS  status;
    int count;

    if (OS_SUCCESS != OsaSemaphoreCheck(*sem))
	{
        /*for inline function, must use LWIP_DEBUGF*/
        do { if (((!diagBlocked . all) && (((g_moduleDebugSettings[(0x00 << 8 & 0xFF00) >> 8]. onoff) == 0x80U) ? 1 : 0) && (LOG_DISABLE != log_config . log_cfg) && (log_config . msg_cfg == ACAT_MSG_ENABLE) && (booting_done))) { LWIP_LOG ("fatal warning! fun: %s, line: %d, semsig: %lx", __FUNCTION__, 373, *sem); ; break; } } while(0);
        return 0xffffffffUL;
    }

    if (timeout == 0) {
        status = OsaSemaphoreAcquire(*sem,0xFFFFFFFF,0);
    } else {
        count =  (timeout+((5)-1))/(5);
        status = OsaSemaphoreAcquire(*sem,count,0);
    }

    if (OS_SUCCESS == status) {
        return ERR_OK;
    }
    return 0xffffffffUL;
}

static inline err_t sys_mbox_new(sys_mbox_t *mbox, int size)
{
    OSA_STATUS status;

    status = OSAMsgQCreate( mbox,

                            "lwipMbox",

                            (sizeof(void*)),
                            size,
                            11);
    { if (!(OS_SUCCESS == status)) { utilsAssertFail("OS_SUCCESS == status", "sys_arch.h", 401, 1); } };
    return ERR_OK;
}

static inline void sys_mbox_poll(sys_mbox_t *mbox,  u32_t *count)
{
    OsaMsgQPoll(*mbox,count,0);
}

static inline void sys_mbox_post(sys_mbox_t *mbox,  msg_t msg)
{
    msg_t*      msg_ptr;
    msg_ptr = (msg != 0) ? (&msg) : (&msg_null);

    OSAMsgQSend( *mbox,
                 sizeof(void*),
                 (UINT8*)msg_ptr,
                 0xFFFFFFFF);
}

static inline err_t sys_mbox_trypost(sys_mbox_t *mbox, msg_t msg)
{
    OSA_STATUS  status;
    msg_t*      msg_ptr;
    u32_t       nums = 0;

    msg_ptr = (msg != 0) ? (&msg) : (&msg_null);
    while (nums++ < 5)
    {
        status = OSAMsgQSend( *mbox,
                              sizeof(void*),
                              (UINT8*)msg_ptr,
                              0);

        if (OS_SUCCESS == status)
        {
            return ERR_OK;
        }
    }
    return ERR_MEM;
}

static inline u32_t sys_arch_mbox_fetch(sys_mbox_t *mbox, msg_t* msg, u32_t timeout)
{
    OSA_STATUS  status;
    int count;

    if (timeout == 0) {
        status = OSAMsgQRecv( *mbox, (UINT8*)msg, sizeof(void*), 0xFFFFFFFF);
    } else {
        count =  (timeout+((5)-1))/(5);
        status = OSAMsgQRecv( *mbox, (UINT8*)msg, sizeof(void*), count);
    }

    if (OS_SUCCESS == status) {
        return ERR_OK;
    }

    return 0xffffffffUL;
}

static inline u32_t sys_arch_mbox_tryfetch(sys_mbox_t *mbox, msg_t* msg)
{
    return sys_arch_mbox_fetch(mbox, msg, 5*(5));
}

static inline u32_t sys_arch_mbox_tryfetch_nosuspend(sys_mbox_t *mbox, msg_t* msg)
{
    OSA_STATUS  status;

    status = OSAMsgQRecv( *mbox, (UINT8*)msg, sizeof(void*), 0);

    if (OS_SUCCESS == status) {
        return ERR_OK;
    }
    return 0xffffffffUL;
}

static inline void sys_mbox_free(sys_mbox_t *mbox)
{
    if (*mbox) {
        OsaMsgQDelete(*mbox,0);
        *mbox = 0;
    }
}

static inline int sys_mbox_valid(sys_mbox_t *mbox)
{
    return 0 != *mbox;
}

static inline void sys_mbox_set_invalid(sys_mbox_t *mbox)
{
    *mbox = 0;
}


static inline u32_t sys_jiffies(void)
{
    return (OsaGetTicks(0) * (5));
}

static inline u32_t sys_now(void)
{
    return (OsaGetTicks(0) * (5));
}

static inline u32_t sys_now_tick(void)
{
    return OsaGetTicks(0);
}

static inline u32_t sys_gen_rand()
{
    u32_t rng = lwip_sys_rand() + lwip_rng_num;
    return rng;
}

