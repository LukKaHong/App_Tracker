    OsaInitParamsT          *pParams            //  [OP,IN] Initialization parameters.
    ) ;

 extern void        OsaRun( void *pForFutureUse );

 extern char        *OsaGetVersion( void );

/*========================================================================
 *  OSA Task Management:
 *========================================================================*/
typedef struct
{
