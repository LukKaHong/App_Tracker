/** indicates this pbuf need do clat */


struct pbuf {
  /** next pbuf in singly linked pbuf chain */
  struct pbuf *next;

  /** pointer to the actual data in the buffer */
  void *payload;

  /**
   * total length of this buffer and all next buffers in chain
   * belonging to the same packet.
   *
   * For non-queue packet chains this is the invariant:
   * p->tot_len == p->len + (p->next? p->next->tot_len: 0)
   */
  u16_t tot_len;

  /** length of this buffer */
  u16_t len;

  /** pointer to the mac header in the buffer */
  void *pkt_mac;

  /** pointer to pmsg */
  pmsg *pkt_msg;

  /**
   * the reference count always equals the number of pointers
   * that refer to this pbuf. This can be pointers from an application,
   * the stack itself, or pbuf->next pointers from a chain.
   */
  u8_t ref;
  /** pbuf_type as u8_t instead of enum to save space */
  u8_t type;
  /** mbox type as u8_t restore which mbox pend this pbuf */
  u8_t mbox;
  /** For imcoming packets, this contains the input netif's netif->num*/
  u8_t ifnum;

  /** misc flags */
  u32_t flags;

  /** record nat_entry for this pbuf */
  void *nat_entry;
  /** record packetfilter_info and tft info for this pbuf */
  /** use pf_info to denote whole tft info valid or invalid, if ps_info = NULL, invalid*/
  void *pf_info;
  u8_t epsid;
  u8_t qfi;
  u8_t psi;
  u8_t rsvd;

  /** extend data */
  s16_t sockid;
  u16_t vlanid;
  u32_t flowid;
  u32_t crtick;
}__attribute__((packed));


/** Prototype for a function to free a custom pbuf */
typedef void (*pbuf_free_custom_fn)(struct pbuf *p);

/** A custom pbuf: like a pbuf, but following a function pointer to free it. */
struct pbuf_custom {
  /** The actual pbuf */
  struct pbuf pbuf;
  /** This function is called when pbuf_free deallocates this pbuf(_custom) */
  pbuf_free_custom_fn custom_free_function;
};



