    uint32_t allocated;             /*!< 目前已分配大小 */
    uint32_t free;                  /*!< 剩余可分配大小 */
    uint32_t max_continuity_free;   /*!< 本平台无效   */
    uint32_t allocated_peak;        /*!< 本平台无效   */
    uint32_t allocated_times;       /*!< 本平台无效   */
    uint32_t free_times;            /*!< 本平台无效   */
} cm_heap_stats_t;

