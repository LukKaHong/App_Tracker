 CI_SS_PRIM_GET_USSD_ENABLE_CNF , /**< \brief \details NOT SUPPORTED REMOVE FROM API */	 
 CI_SS_PRIM_SET_USSD_ENABLE_REQ , /**< \brief Requests to enable or disable unsolicited USSD indications	 
