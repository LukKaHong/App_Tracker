 {			 
 L1aAgcCalEnd ( ) ;			 
 }		 
 else		 
 {			 
 return ;			 
 }		 
 OsaTaskSleep ( 10 , 0 ) ; // 50 ms delay for Rx Apc / Agc end ack		 
 L1aEndCalMode ( ) ;		 
 OsaTaskSleep ( 10 , 0 ) ; // 50 ms delay for Rx End cal ack.		 
 L1aReturnToNormalMode ( ) ;		 
 l1aForceTxRxState = L1A_FORCE_TX_RX_NULL ;		 
 }	 
 }

